# PostgreSQL (Supabase connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# Supabase — brauzer uchun (VITE_ prefiks shart)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase — faqat server (frontendga bermang!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Ixtiyoriy
PORT=5001
NODE_ENV=development
# Frontend va server originlari (vergul bilan ajrating). Productionda to'liq domain kiriting.
# Dev: Vite 5173 + server 5001. Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001
# DB SSL: Supabase pooler uchun "false" (CA muammosi), productionda "true" (xavfsiz)
DB_SSL_REJECT_UNAUTHORIZED=false
