{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(.env.example)",
      "WebFetch(domain:supabase.com)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(dist/**)",
      "Edit(scratch/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-typecheck.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
